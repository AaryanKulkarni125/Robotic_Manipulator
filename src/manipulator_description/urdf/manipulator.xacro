<?xml version="1.0"?>

<robot name="manipulator" xmlns:xacro="http://www.ros.org/wiki/xacro">

  
  <!-- INCLUDE MODULAR XACRO FILES -->
 

  <xacro:include filename="$(find manipulator_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find manipulator_description)/urdf/inertial_macros.xacro"/>


  
  <!-- ROBOT DIMENSIONS -->
  

  <!-- Base -->
  <xacro:property name="base_height" value="0.15"/>
  <xacro:property name="base_radius" value="0.10"/>

  <!-- Arm links -->
  <xacro:property name="link1_length" value="0.30"/>
  <xacro:property name="link1_radius" value="0.040"/>

  <xacro:property name="link2_length" value="0.30"/>
  <xacro:property name="link2_radius" value="0.035"/>

  <!-- End effector -->
  <xacro:property name="ee_length" value="0.10"/>
  <xacro:property name="ee_radius" value="0.025"/>


  
  <!-- ROBOT MASSES -->
  

  <xacro:property name="base_mass" value="1.5"/>
  <xacro:property name="link1_mass" value="0.8"/>
  <xacro:property name="link2_mass" value="0.6"/>
  <xacro:property name="ee_mass" value="0.2"/>


  
  <!-- BASE LINK -->
  

  <link name="base_link">

    <visual>
      <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>

      <geometry>
        <cylinder
          radius="${base_radius}"
          length="${base_height}"/>
      </geometry>

      <material name="base_material"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>

      <geometry>
        <cylinder
          radius="${base_radius}"
          length="${base_height}"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertia_z
      mass="${base_mass}"
      radius="${base_radius}"
      length="${base_height}"/>

  </link>


  
  <!-- JOINT 1 -->
  <!-- Revolute joint about Z  -->
 

  <joint name="joint1" type="revolute">

    <parent link="base_link"/>
    <child link="link1"/>

    <origin
      xyz="0 0 ${base_height}"
      rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="-3.14159265"
      upper="3.14159265"
      effort="10"
      velocity="1.0"/>

  </joint>


  
  <!-- LINK 1 -->
  <!-- Cylinder along X -->
 

  <link name="link1">

    <visual>
      <origin
        xyz="${link1_length / 2} 0 0"
        rpy="0 1.57079633 0"/>

      <geometry>
        <cylinder
          radius="${link1_radius}"
          length="${link1_length}"/>
      </geometry>

      <material name="link1_material"/>
    </visual>

    <collision>
      <origin
        xyz="${link1_length / 2} 0 0"
        rpy="0 1.57079633 0"/>

      <geometry>
        <cylinder
          radius="${link1_radius}"
          length="${link1_length}"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertia_x
      mass="${link1_mass}"
      radius="${link1_radius}"
      length="${link1_length}"/>

  </link>


  
  <!-- JOINT 2 -->
  <!-- Revolute joint about Y -->
  

  <joint name="joint2" type="revolute">

    <parent link="link1"/>
    <child link="link2"/>

    <origin
      xyz="${link1_length} 0 0"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-1.57079633"
      upper="1.57079633"
      effort="10"
      velocity="1.0"/>

  </joint>


  
  <!-- LINK 2 -->
  <!-- Cylinder along X -->
  

  <link name="link2">

    <visual>
      <origin
        xyz="${link2_length / 2} 0 0"
        rpy="0 1.57079633 0"/>

      <geometry>
        <cylinder
          radius="${link2_radius}"
          length="${link2_length}"/>
      </geometry>

      <material name="link2_material"/>
    </visual>

    <collision>
      <origin
        xyz="${link2_length / 2} 0 0"
        rpy="0 1.57079633 0"/>

      <geometry>
        <cylinder
          radius="${link2_radius}"
          length="${link2_length}"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertia_x
      mass="${link2_mass}"
      radius="${link2_radius}"
      length="${link2_length}"/>

  </link>



  <!-- JOINT 3 -->
  <!-- Revolute joint about Y -->
 

  <joint name="joint3" type="revolute">

    <parent link="link2"/>
    <child link="end_effector"/>

    <origin
      xyz="${link2_length} 0 0"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-2.35619449"
      upper="2.35619449"
      effort="5"
      velocity="1.0"/>

  </joint>


  
  <!-- END EFFECTOR -->
  

  <link name="end_effector">

    <visual>
      <origin
        xyz="${ee_length / 2} 0 0"
        rpy="0 1.57079633 0"/>

      <geometry>
        <cylinder
          radius="${ee_radius}"
          length="${ee_length}"/>
      </geometry>

      <material name="end_effector_material"/>
    </visual>

    <collision>
      <origin
        xyz="${ee_length / 2} 0 0"
        rpy="0 1.57079633 0"/>

      <geometry>
        <cylinder
          radius="${ee_radius}"
          length="${ee_length}"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertia_x
      mass="${ee_mass}"
      radius="${ee_radius}"
      length="${ee_length}"/>

  </link>


</robot>

