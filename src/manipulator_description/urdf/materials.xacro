<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Base material -->
  <material name="base_material">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <!-- Link 1 material -->
  <material name="link1_material">
    <color rgba="0.1 0.4 0.8 1.0"/>
  </material>

  <!-- Link 2 material -->
  <material name="link2_material">
    <color rgba="0.1 0.7 0.3 1.0"/>
  </material>

  <!-- End-effector material -->
  <material name="end_effector_material">
    <color rgba="0.8 0.4 0.1 1.0"/>
  </material>

</robot>

