<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Cylinder whose longitudinal axis is the X-axis.

    Ixx = 1/2 m r^2
    Iyy = Izz = 1/12 m (3r^2 + L^2)
  -->

  <xacro:macro name="cylinder_inertia_x" params="mass radius length">

    <inertial>

      <origin xyz="${length / 2} 0 0" rpy="0 0 0"/>

      <mass value="${mass}"/>

      <inertia
        ixx="${0.5 * mass * radius * radius}"
        ixy="0.0"
        ixz="0.0"
        iyy="${(1.0 / 12.0) * mass * (3.0 * radius * radius + length * length)}"
        iyz="0.0"
        izz="${(1.0 / 12.0) * mass * (3.0 * radius * radius + length * length)}"/>

    </inertial>

  </xacro:macro>


  <!--
    Cylinder whose longitudinal axis is the Z-axis.

    Ixx = Iyy = 1/12 m (3r^2 + L^2)
    Izz = 1/2 m r^2
  -->

  <xacro:macro name="cylinder_inertia_z" params="mass radius length">

    <inertial>

      <origin xyz="0 0 ${length / 2}" rpy="0 0 0"/>

      <mass value="${mass}"/>

      <inertia
        ixx="${(1.0 / 12.0) * mass * (3.0 * radius * radius + length * length)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${(1.0 / 12.0) * mass * (3.0 * radius * radius + length * length)}"
        iyz="0.0"
        izz="${0.5 * mass * radius * radius}"/>

    </inertial>

  </xacro:macro>

</robot>

